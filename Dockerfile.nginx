FROM nginx:alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Use template so envsubst can inject Render's $PORT
COPY default.conf.template /etc/nginx/templates/default.conf.template

# Robust DNS wait script using nslookup loop
RUN printf '#!/bin/sh\n\
echo "Waiting for API nodes..."\n\
for host in api1 api2 api3; do\n\
  while ! nslookup $host > /dev/null 2>&1; do\n\
    echo "Waiting for $host to resolve..."\n\
    sleep 2\n\
  done\n\
done\n\
echo "DNS ready. Starting NGINX."\n' > /docker-entrypoint.d/00-wait-for-dns.sh && chmod +x /docker-entrypoint.d/00-wait-for-dns.sh
